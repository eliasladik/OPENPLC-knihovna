  "sources": [
    {
      "fileName": "CUSTOM_PWM_CTRL.st",
      "source": "FUNCTION_BLOCK CUSTOM_PWM_CTRL\n  VAR_INPUT\n    procenta : INT;\n    povoleni : BOOL;\n  END_VAR\n  VAR\n    pomocna_procenta : UINT;\n    pomocna_zacatek : UINT := 0;\n    pomocna_out : UINT;\n    procenta_limit : INT;\n  END_VAR\n  VAR_OUTPUT\n    pwm_out : UINT;\n  END_VAR\n  VAR\n    _TMP_LIMIT1600273_ENO : BOOL;\n    _TMP_LIMIT1600273_OUT : INT;\n    _TMP_TO_UINT8009467_ENO : BOOL;\n    _TMP_TO_UINT8009467_OUT : UINT;\n    _TMP_MUL5117243_ENO : BOOL;\n    _TMP_MUL5117243_OUT : UINT;\n    _TMP_SEL3641176_ENO : BOOL;\n    _TMP_SEL3641176_OUT : UINT;\n  END_VAR\n\n  _TMP_LIMIT1600273_OUT := LIMIT(EN := TRUE, MN := 0, IN := procenta, MX := 100, ENO => _TMP_LIMIT1600273_ENO);\n  IF _TMP_LIMIT1600273_ENO THEN\n      procenta_limit := _TMP_LIMIT1600273_OUT;\n  END_IF;\n  _TMP_TO_UINT8009467_OUT := TO_UINT(EN := TRUE, IN := procenta_limit, ENO => _TMP_TO_UINT8009467_ENO);\n  IF _TMP_TO_UINT8009467_ENO THEN\n      pomocna_procenta := _TMP_TO_UINT8009467_OUT;\n  END_IF;\n  _TMP_MUL5117243_OUT := MUL(EN := _TMP_TO_UINT8009467_ENO, IN1 := pomocna_procenta, IN2 := 655, ENO => _TMP_MUL5117243_ENO);\n  IF _TMP_MUL5117243_ENO THEN\n      pomocna_out := _TMP_MUL5117243_OUT;\n  END_IF;\n  _TMP_SEL3641176_OUT := SEL(EN := TRUE, G := povoleni, IN0 := pomocna_zacatek, IN1 := pomocna_out, ENO => _TMP_SEL3641176_ENO);\n  IF _TMP_SEL3641176_ENO THEN\n      pwm_out := _TMP_SEL3641176_OUT;\n  END_IF;\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "L298N.st",
      "source": "FUNCTION_BLOCK L298N\n  VAR_INPUT\n    procenta : INT;\n    FORWARD : BOOL;\n    BACKWARDS : BOOL;\n    E_STOP : BOOL;\n  END_VAR\n  VAR_OUTPUT\n    pwm_out : UINT;\n    IN1 : BOOL;\n    IN2 : BOOL;\n  END_VAR\n  VAR\n    CUSTOM_PWM_CTRL0 : CUSTOM_PWM_CTRL;\n  END_VAR\n\n  CUSTOM_PWM_CTRL0(EN := NOT(E_STOP), procenta := procenta, povoleni := BACKWARDS OR FORWARD);\n  IF CUSTOM_PWM_CTRL0.ENO THEN\n      pwm_out := CUSTOM_PWM_CTRL0.pwm_out;\n  END_IF;\n  IN1 := NOT(BACKWARDS) AND FORWARD AND NOT(E_STOP);\n  IN2 := BACKWARDS AND NOT(FORWARD) AND NOT(E_STOP);\nEND_FUNCTION_BLOCK\n"
    }
  ]
}
