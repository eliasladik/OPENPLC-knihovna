  "chunks": [
    {
      "name": "FB_CUSTOM_PWM_CTRL",
      "kind": "functionBlock",
      "header": "class FB_CUSTOM_PWM_CTRL {\npublic:\n    // Inputs\n    IEC_INT PROCENTA;\n    IEC_BOOL POVOLENI;\n    // Local variables\n    IEC_UINT POMOCNA_PROCENTA;\n    IEC_UINT POMOCNA_ZACATEK;\n    IEC_UINT POMOCNA_OUT;\n    IEC_INT PROCENTA_LIMIT;\n    // Outputs\n    IEC_UINT PWM_OUT;\n    // Local variables\n    IEC_BOOL _TMP_LIMIT1600273_ENO;\n    IEC_INT _TMP_LIMIT1600273_OUT;\n    IEC_BOOL _TMP_TO_UINT8009467_ENO;\n    IEC_UINT _TMP_TO_UINT8009467_OUT;\n    IEC_BOOL _TMP_MUL5117243_ENO;\n    IEC_UINT _TMP_MUL5117243_OUT;\n    IEC_BOOL _TMP_SEL3641176_ENO;\n    IEC_UINT _TMP_SEL3641176_OUT;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    FB_CUSTOM_PWM_CTRL();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~FB_CUSTOM_PWM_CTRL() = default;\n};\n",
      "cpp": "FB_CUSTOM_PWM_CTRL::FB_CUSTOM_PWM_CTRL()\n    : POMOCNA_ZACATEK(0)\n{\n    // Initialize variables\n}\n\nvoid FB_CUSTOM_PWM_CTRL::operator()() {\n    if (true) {\n        _TMP_LIMIT1600273_OUT = LIMIT(static_cast<IEC_INT>(0), PROCENTA, static_cast<IEC_INT>(100));\n        _TMP_LIMIT1600273_ENO = true;\n    } else {\n        _TMP_LIMIT1600273_ENO = false;\n    }\n    if (_TMP_LIMIT1600273_ENO) {\n        PROCENTA_LIMIT = _TMP_LIMIT1600273_OUT;\n    }\n    if (true) {\n        _TMP_TO_UINT8009467_OUT = TO_UINT(PROCENTA_LIMIT);\n        _TMP_TO_UINT8009467_ENO = true;\n    } else {\n        _TMP_TO_UINT8009467_ENO = false;\n    }\n    if (_TMP_TO_UINT8009467_ENO) {\n        POMOCNA_PROCENTA = _TMP_TO_UINT8009467_OUT;\n    }\n    if (_TMP_TO_UINT8009467_ENO) {\n        _TMP_MUL5117243_OUT = MUL(POMOCNA_PROCENTA, static_cast<IEC_UINT>(655));\n        _TMP_MUL5117243_ENO = true;\n    } else {\n        _TMP_MUL5117243_ENO = false;\n    }\n    if (_TMP_MUL5117243_ENO) {\n        POMOCNA_OUT = _TMP_MUL5117243_OUT;\n    }\n    if (true) {\n        _TMP_SEL3641176_OUT = SEL(POVOLENI, POMOCNA_ZACATEK, POMOCNA_OUT);\n        _TMP_SEL3641176_ENO = true;\n    } else {\n        _TMP_SEL3641176_ENO = false;\n    }\n    if (_TMP_SEL3641176_ENO) {\n        PWM_OUT = _TMP_SEL3641176_OUT;\n    }\n}\n",
      "deps": [
        {
          "library": "iec-std-functions",
          "name": "LIMIT"
        },
        {
          "library": "iec-std-functions",
          "name": "MUL"
        },
        {
          "library": "iec-std-functions",
          "name": "SEL"
        },
        {
          "library": "iec-std-functions",
          "name": "TO_UINT"
        }
      ]
    },
    {
      "name": "FB_ROTARYENCODER",
      "kind": "functionBlock",
      "header": "class FB_ROTARYENCODER {\npublic:\n    // Inputs\n    IEC_BOOL CLK;\n    IEC_BOOL DT;\n    // Outputs\n    IEC_INT COUNT;\n    // Local variables\n    R_TRIG R_TRIG0;\n    F_TRIG F_TRIG0;\n    IEC_BOOL _TMP_ADD3264124_ENO;\n    IEC_INT _TMP_ADD3264124_OUT;\n    IEC_BOOL _TMP_SUB7835081_ENO;\n    IEC_INT _TMP_SUB7835081_OUT;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    FB_ROTARYENCODER();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~FB_ROTARYENCODER() = default;\n};\n",
      "cpp": "FB_ROTARYENCODER::FB_ROTARYENCODER()\n    : COUNT(0)\n{\n    // Initialize variables\n}\n\nvoid FB_ROTARYENCODER::operator()() {\n    R_TRIG0.CLK = CLK;\n    R_TRIG0();\n    R_TRIG0.ENO = true;\n    F_TRIG0.CLK = CLK;\n    F_TRIG0();\n    F_TRIG0.ENO = true;\n    if (((DT) & (F_TRIG0.Q)) | ((NOT(DT)) & (R_TRIG0.Q))) {\n        _TMP_ADD3264124_OUT = ADD(COUNT, static_cast<IEC_INT>(1));\n        _TMP_ADD3264124_ENO = true;\n    } else {\n        _TMP_ADD3264124_ENO = false;\n    }\n    if (_TMP_ADD3264124_ENO) {\n        COUNT = _TMP_ADD3264124_OUT;\n    }\n    if (((DT) & (R_TRIG0.Q)) | ((NOT(DT)) & (F_TRIG0.Q))) {\n        _TMP_SUB7835081_OUT = SUB(COUNT, static_cast<IEC_INT>(1));\n        _TMP_SUB7835081_ENO = true;\n    } else {\n        _TMP_SUB7835081_ENO = false;\n    }\n    if (_TMP_SUB7835081_ENO) {\n        COUNT = _TMP_SUB7835081_OUT;\n    }\n}\n",
      "deps": [
        {
          "library": "iec-standard-fb",
          "name": "F_TRIG"
        },
        {
          "library": "iec-standard-fb",
          "name": "R_TRIG"
        },
        {
          "library": "iec-std-functions",
          "name": "ADD"
        },
        {
          "library": "iec-std-functions",
          "name": "NOT"
        },
        {
          "library": "iec-std-functions",
          "name": "SUB"
        }
      ]
    },
    {
      "name": "FB_TOGGLE",
      "kind": "functionBlock",
      "header": "class FB_TOGGLE {\npublic:\n    // Inputs\n    IEC_BOOL IN;\n    // Outputs\n    IEC_BOOL OUT;\n    // Local variables\n    IEC_BOOL PULS;\n    R_TRIG R_TRIG0;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    FB_TOGGLE();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~FB_TOGGLE() = default;\n};\n",
      "cpp": "FB_TOGGLE::FB_TOGGLE() {\n    // Initialize variables\n}\n\nvoid FB_TOGGLE::operator()() {\n    R_TRIG0.CLK = IN;\n    R_TRIG0();\n    R_TRIG0.ENO = true;\n    PULS = R_TRIG0.Q;\n    OUT = ((NOT(OUT)) & (PULS)) | ((OUT) & (NOT(PULS)));\n}\n",
      "deps": [
        {
          "library": "iec-standard-fb",
          "name": "R_TRIG"
        },
        {
          "library": "iec-std-functions",
          "name": "NOT"
        }
      ]
    },
    {
      "name": "FB_L298N",
      "kind": "functionBlock",
      "header": "class FB_L298N {\npublic:\n    // Inputs\n    IEC_INT PROCENTA;\n    IEC_BOOL FORWARD;\n    IEC_BOOL BACKWARDS;\n    IEC_BOOL E_STOP;\n    // Outputs\n    IEC_UINT PWM_OUT;\n    IEC_BOOL IN1;\n    IEC_BOOL IN2;\n    // Local variables\n    FB_CUSTOM_PWM_CTRL FB_CUSTOM_PWM_CTRL0;\n\n    // Implicit IEC 61131-3 ENO pin (mirrors EN)\n    IEC_BOOL ENO = true;\n\n    // Constructor\n    FB_L298N();\n\n    // Execute function block\n    void operator()();\n\n    virtual ~FB_L298N() = default;\n};\n",
      "cpp": "FB_L298N::FB_L298N() {\n    // Initialize variables\n}\n\nvoid FB_L298N::operator()() {\n    FB_CUSTOM_PWM_CTRL0.PROCENTA = PROCENTA;\n    FB_CUSTOM_PWM_CTRL0.POVOLENI = (IN1) | (IN2);\n    if (NOT(E_STOP)) {\n        FB_CUSTOM_PWM_CTRL0();\n        FB_CUSTOM_PWM_CTRL0.ENO = true;\n    } else {\n        FB_CUSTOM_PWM_CTRL0.ENO = false;\n    }\n    if (FB_CUSTOM_PWM_CTRL0.ENO) {\n        PWM_OUT = FB_CUSTOM_PWM_CTRL0.PWM_OUT;\n    }\n    IN1 = ((NOT(BACKWARDS)) & (FORWARD)) & (NOT(E_STOP));\n    IN2 = ((BACKWARDS) & (NOT(FORWARD))) & (NOT(E_STOP));\n}\n",
      "deps": [
        {
          "library": "iec-std-functions",
          "name": "NOT"
        },
        {
          "library": "knihovna-moje",
          "name": "FB_CUSTOM_PWM_CTRL"
        }
      ]
    }
  ],
  "dependencies": [
    {
      "name": "knihovna-moje",
      "version": "0.1.0"
    }
  ],
  "sources": [
    {
      "fileName": "FB_CUSTOM_PWM_CTRL.st",
      "source": "FUNCTION_BLOCK FB_CUSTOM_PWM_CTRL\n  VAR_INPUT\n    procenta : INT;\n    povoleni : BOOL;\n  END_VAR\n  VAR\n    pomocna_procenta : UINT;\n    pomocna_zacatek : UINT := 0;\n    pomocna_out : UINT;\n    procenta_limit : INT;\n  END_VAR\n  VAR_OUTPUT\n    pwm_out : UINT;\n  END_VAR\n  VAR\n    _TMP_LIMIT1600273_ENO : BOOL;\n    _TMP_LIMIT1600273_OUT : INT;\n    _TMP_TO_UINT8009467_ENO : BOOL;\n    _TMP_TO_UINT8009467_OUT : UINT;\n    _TMP_MUL5117243_ENO : BOOL;\n    _TMP_MUL5117243_OUT : UINT;\n    _TMP_SEL3641176_ENO : BOOL;\n    _TMP_SEL3641176_OUT : UINT;\n  END_VAR\n\n  _TMP_LIMIT1600273_OUT := LIMIT(EN := TRUE, MN := 0, IN := procenta, MX := 100, ENO => _TMP_LIMIT1600273_ENO);\n  IF _TMP_LIMIT1600273_ENO THEN\n      procenta_limit := _TMP_LIMIT1600273_OUT;\n  END_IF;\n  _TMP_TO_UINT8009467_OUT := TO_UINT(EN := TRUE, IN := procenta_limit, ENO => _TMP_TO_UINT8009467_ENO);\n  IF _TMP_TO_UINT8009467_ENO THEN\n      pomocna_procenta := _TMP_TO_UINT8009467_OUT;\n  END_IF;\n  _TMP_MUL5117243_OUT := MUL(EN := _TMP_TO_UINT8009467_ENO, IN1 := pomocna_procenta, IN2 := 655, ENO => _TMP_MUL5117243_ENO);\n  IF _TMP_MUL5117243_ENO THEN\n      pomocna_out := _TMP_MUL5117243_OUT;\n  END_IF;\n  _TMP_SEL3641176_OUT := SEL(EN := TRUE, G := povoleni, IN0 := pomocna_zacatek, IN1 := pomocna_out, ENO => _TMP_SEL3641176_ENO);\n  IF _TMP_SEL3641176_ENO THEN\n      pwm_out := _TMP_SEL3641176_OUT;\n  END_IF;\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "FB_L298N.st",
      "source": "FUNCTION_BLOCK FB_L298N\n  VAR_INPUT\n    procenta : INT;\n    FORWARD : BOOL;\n    BACKWARDS : BOOL;\n    E_STOP : BOOL;\n  END_VAR\n  VAR_OUTPUT\n    pwm_out : UINT;\n    IN1 : BOOL;\n    IN2 : BOOL;\n  END_VAR\n  VAR\n    FB_CUSTOM_PWM_CTRL0 : FB_CUSTOM_PWM_CTRL;\n  END_VAR\n\n  FB_CUSTOM_PWM_CTRL0(EN := NOT(E_STOP), procenta := procenta, povoleni := IN1 OR IN2);\n  IF FB_CUSTOM_PWM_CTRL0.ENO THEN\n      pwm_out := FB_CUSTOM_PWM_CTRL0.pwm_out;\n  END_IF;\n  IN1 := NOT(BACKWARDS) AND FORWARD AND NOT(E_STOP);\n  IN2 := BACKWARDS AND NOT(FORWARD) AND NOT(E_STOP);\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "FB_RotaryEncoder.st",
      "source": "FUNCTION_BLOCK FB_RotaryEncoder\n  VAR_INPUT\n    CLK : BOOL;\n    DT : BOOL;\n  END_VAR\n  VAR_OUTPUT\n    COUNT : INT := 0;\n  END_VAR\n  VAR\n    R_TRIG0 : R_TRIG;\n    F_TRIG0 : F_TRIG;\n    _TMP_ADD3264124_ENO : BOOL;\n    _TMP_ADD3264124_OUT : INT;\n    _TMP_SUB7835081_ENO : BOOL;\n    _TMP_SUB7835081_OUT : INT;\n  END_VAR\n\n  R_TRIG0(CLK := CLK);\n  F_TRIG0(CLK := CLK);\n  _TMP_ADD3264124_OUT := ADD(EN := DT AND F_TRIG0.Q OR NOT(DT) AND R_TRIG0.Q, IN1 := COUNT, IN2 := 1, ENO => _TMP_ADD3264124_ENO);\n  IF _TMP_ADD3264124_ENO THEN\n      COUNT := _TMP_ADD3264124_OUT;\n  END_IF;\n  _TMP_SUB7835081_OUT := SUB(EN := DT AND R_TRIG0.Q OR NOT(DT) AND F_TRIG0.Q, IN1 := COUNT, IN2 := 1, ENO => _TMP_SUB7835081_ENO);\n  IF _TMP_SUB7835081_ENO THEN\n      COUNT := _TMP_SUB7835081_OUT;\n  END_IF;\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "FB_Toggle.st",
      "source": "FUNCTION_BLOCK FB_Toggle\n  VAR_INPUT\n    IN : BOOL;\n  END_VAR\n  VAR_OUTPUT\n    OUT : BOOL;\n  END_VAR\n  VAR\n    puls : BOOL;\n    R_TRIG0 : R_TRIG;\n  END_VAR\n\n  R_TRIG0(CLK := IN);\n  puls := R_TRIG0.Q;\n  OUT := NOT(OUT) AND puls OR OUT AND NOT(puls);\nEND_FUNCTION_BLOCK\n"
    },
    {
      "fileName": "FB_CUSTOM_PWM.cpp",
      "source": "FUNCTION_BLOCK FB_CUSTOM_PWM\n  VAR_INPUT\n    PinNr : UINT := 2; (* default: PinNr = 2 (Backlight) *)\n    iDutycycle : INT; (* Střída v procentech: 0 ... 100 % *)\n    bEnable : BOOL := FALSE;\n  END_VAR\n  VAR_OUTPUT\n    bActive : BOOL;    (* TRUE: PWM výstup je aktivní (> 0 %) *)\n    bError : BOOL;     (* TRUE: Vstup iDutycycle > 100 % *)\n    wRawDuty : UINT;   (* Hodnota zápisu do PWM registru: 0 ... 4095 *)\n  END_VAR\n  VAR_EXTERNAL\n  END_VAR\n/* ================================================================\n *  C/C++ FUNCTION BLOCK\n * ================================================================ */\n\n#include <stdio.h>\n#include <stdint.h>\n#include <stdbool.h>\n#include <Arduino.h>\n\n// Nastavení rozlišení a maximální hodnota střídy podle architektury\n#if defined(ESP32)\n  const int PWM_FREQU = 1000;\n  const int PWM_RES = 12;\n  const int MAX_DUTY_CYCLE = (1 << PWM_RES) - 1; // 4095 (12 bitů)\n#elif defined(ESP8266)\n  const int MAX_DUTY_CYCLE = 1023;                // 1023 (10 bitů)\n#else\n  // AVR Arduino (Uno, Mega, Nano), STM32, RP2040 atd.\n  const int MAX_DUTY_CYCLE = 255;                 // 255 (8 bitů)\n#endif\n\nvoid setup()\n{\n  #if defined(ESP32)\n    ledcAttach(PinNr, PWM_FREQU, PWM_RES);\n  #elif defined(ESP8266)\n    analogWriteFreq(1000); // Nastavení frekvence PWM 1 kHz pro ESP8266\n  #endif\n}\n\nvoid loop()\n{ \n  // Detekce chyby rozsahu vstupu (mimo rozsah 0 až 100 %)\n  bError = (iDutycycle < 0) || (iDutycycle > 100);\n\n  int dimmer = 0;\n\n  // Výpočet střídy proběhne pouze při povolení a platném vstupu\n  if (bEnable && !bError)\n  {\n    int dutyPercent = constrain((int)iDutycycle, 0, 100);\n    dimmer = map(dutyPercent, 0, 100, 0, MAX_DUTY_CYCLE);\n  }\n\n  // Zápis na HW pin podle mikrokontroléru\n  #if defined(ESP32)\n    ledcWrite(PinNr, dimmer);\n  #else\n    analogWrite(PinNr, dimmer);\n  #endif\n\n  // Aktualizace stavových výstupů PLC\n  wRawDuty = (uint16_t)dimmer;\n  bActive = bEnable && (dimmer > 0);\n}\n\nEND_FUNCTION_BLOCK"
    }
  ]
}
